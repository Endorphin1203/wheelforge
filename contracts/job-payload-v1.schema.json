{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WheelForge database job payload v1",
  "type": "object",
  "required": ["schemaVersion", "jobType", "subjectId", "createdAt", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobType": {"enum": ["REQUIREMENT_PARSE", "BUILD"]},
    "subjectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"jobType": {"const": "REQUIREMENT_PARSE"}},
        "required": ["jobType"]
      },
      "then": {"properties": {"payload": {"$ref": "#/$defs/requirementParsePayload"}}}
    },
    {
      "if": {
        "properties": {"jobType": {"const": "BUILD"}},
        "required": ["jobType"]
      },
      "then": {"properties": {"payload": {"$ref": "#/$defs/buildPayload"}}}
    }
  ],
  "$defs": {
    "requirementParsePayload": {
      "type": "object",
      "required": ["originalObjectKey", "normalizedObjectKey"],
      "properties": {
        "originalObjectKey": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "normalizedObjectKey": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    "buildPayload": {
      "type": "object",
      "required": [
        "requirementFileId",
        "normalizedObjectKey",
        "solveMode",
        "targetSnapshot"
      ],
      "properties": {
        "requirementFileId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "normalizedObjectKey": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "solveMode": {"const": "COMPATIBLE"},
        "targetSnapshot": {"$ref": "#/$defs/targetSnapshot"}
      },
      "additionalProperties": false
    },
    "targetSnapshot": {
      "type": "object",
      "required": [
        "profileId",
        "profileCode",
        "os",
        "architecture",
        "pythonImplementation",
        "pythonVersion",
        "pythonFullVersion",
        "platformTag",
        "abiTags",
        "validationType",
        "validationPolicyVersion",
        "profileVersion"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "profileCode": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "os": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "architecture": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "pythonImplementation": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "pythonVersion": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "pythonFullVersion": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "platformTag": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "abiTags": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "validationType": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "validationPolicyVersion": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "profileVersion": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
