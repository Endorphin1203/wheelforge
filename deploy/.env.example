# Install as /etc/wheelforge/wheelforge.env with owner root:root and mode 0600.
WF_JDBC_URL=jdbc:mysql://127.0.0.1:3306/wheelforge?connectionTimeZone=UTC
WF_DATABASE_URL=mysql+pymysql://wheelforge:replace-with-url-encoded-password@127.0.0.1:3306/wheelforge
WF_DATABASE_HOST=127.0.0.1
WF_DATABASE_PORT=3306
WF_DATABASE_NAME=wheelforge
WF_DATABASE_USER=wheelforge
WF_DATABASE_PASSWORD=replace-with-database-password
WF_AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
WF_BOOTSTRAP_ADMIN_USERNAME=admin
WF_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-initial-admin-password
WF_DATA_ROOT=/var/lib/wheelforge/data
WF_WORKSPACE_ROOT=/var/lib/wheelforge/work
WF_FRONTEND_ROOT=/opt/wheelforge/frontend/dist
WF_QUEUE_POLL_SECONDS=2
WF_JOB_LEASE_SECONDS=60
WF_MAINTENANCE_AGE_SECONDS=86400
WF_WORKER_ID=wheelforge-worker-1
WF_RETENTION_ENABLED=true
WF_RETENTION_BATCH_SIZE=100
WF_RETENTION_FIXED_DELAY_MS=60000
WF_RETENTION_ACTIVE_DOWNLOAD_LEASE_SECONDS=300
